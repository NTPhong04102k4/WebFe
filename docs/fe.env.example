# Sao chép thành .env / .env.development / .env.production trong repo FRONTEND (Vite).
# Không commit file .env chứa secret thật.

# --- Bắt buộc: base URL của SoldCars Web API (không có suffix /api toàn cục) ---
# Local: xem Web API Properties/launchSettings.json (thường https://localhost:7250 hoặc http://localhost:5000)
# Staging/Prod: URL deploy của bạn (mỗi môi trường một giá trị)
VITE_API_BASE_URL=https://localhost:7250

# --- Tuỳ chọn: redirect sau thanh toán (SePay / cổng thanh toán) ---
# VITE_RETURN_URL=https://your-frontend-host/soldcars/payment/success
# VITE_CANCEL_URL=https://your-frontend-host/soldcars/payment/cancel
